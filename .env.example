# Copia este archivo como .env y rellena los valores (en Render se ponen en "Environment").

# Puerto y URL pública (se usa en los enlaces de los correos; en Render se detecta sola)
PORT=3000
APP_URL=http://localhost:3000

# --- Base de datos ---
# Opción A: MySQL / MariaDB (por ejemplo, la de Hostinger). Si MYSQL_HOST está definido, se usa MySQL.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Pon true solo si tu servidor MySQL exige conexión cifrada
MYSQL_SSL=false
# (También vale una sola variable: DATABASE_URL=mysql://usuario:clave@host:3306/basedatos)

# Opción B: sin MYSQL_HOST se usa un archivo SQLite local (ideal para probar en tu ordenador)
DB_FILE=data/horario.db

# --- Envío de correo (SMTP) ---
# Sin SMTP_HOST, los correos se muestran en la consola en lugar de enviarse.
# Brevo (gratis, 300 correos/día). El puerto 2525 funciona también en el plan gratuito de Render.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Ejemplo con Brevo:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_USER=tu-usuario@smtp-brevo.com
# SMTP_PASS=tu-clave-smtp-de-brevo
# MAIL_FROM="Horaria <tu-correo-verificado@ejemplo.com>"
