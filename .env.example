# Copia este archivo como .env y rellena los valores.

# Puerto y URL pública (se usa en los enlaces de los correos)
PORT=3000
APP_URL=http://localhost:3000

# Ruta del archivo de base de datos SQLite
DB_FILE=data/horario.db

# Pon "true" si la app está detrás de un proxy HTTPS (Render, Railway, Nginx…)
TRUST_PROXY=false

# --- Envío de correo (SMTP) ---
# Sin SMTP_HOST, los correos se muestran en la consola en lugar de enviarse.
# Ejemplo con Gmail: activa la verificación en 2 pasos y crea una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=contraseña-de-aplicacion
MAIL_FROM="Mi Horario <tu-correo@gmail.com>"
